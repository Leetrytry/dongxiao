<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E8DCECDF" />
            <stroke
                android:width="1dp"
                android:color="#B6D97706" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#D9FFF7E6" />
            <stroke
                android:width="1dp"
                android:color="#80D97706" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
