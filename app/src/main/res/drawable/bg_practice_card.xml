<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/cinnabar_soft" />
            <stroke
                android:width="2dp"
                android:color="@color/cinnabar" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/paper"
                android:startColor="@color/surface_warm" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
