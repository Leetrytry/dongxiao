<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E8F1E5" />
            <stroke
                android:width="1dp"
                android:color="@color/bamboo" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/paper"
                android:startColor="@color/surface_warm" />
            <stroke
                android:width="1dp"
                android:color="@color/gold" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
