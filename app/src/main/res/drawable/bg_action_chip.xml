<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/cinnabar" />
            <corners android:radius="999dp" />
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/cinnabar_soft" />
            <stroke
                android:width="1dp"
                android:color="#F2B7A8" />
            <corners android:radius="999dp" />
            <padding
                android:bottom="8dp"
                android:left="12dp"
                android:right="12dp"
                android:top="8dp" />
        </shape>
    </item>
</selector>
