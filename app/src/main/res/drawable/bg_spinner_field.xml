<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/paper" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/cinnabar" />
                    <corners android:radius="12dp" />
                    <padding
                        android:bottom="8dp"
                        android:left="10dp"
                        android:right="36dp"
                        android:top="8dp" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_spinner_chevron"
                android:gravity="right|center_vertical"
                android:right="8dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#F8FFFBF0" />
                    <corners android:radius="12dp" />
                    <padding
                        android:bottom="8dp"
                        android:left="10dp"
                        android:right="36dp"
                        android:top="8dp" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_spinner_chevron"
                android:gravity="right|center_vertical"
                android:right="8dp" />
        </layer-list>
    </item>
</selector>
